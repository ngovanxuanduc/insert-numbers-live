{
  "name": "insert-numbers-live",
  "displayName": "Insert Numbers Live",
  "description": "Insert numbers, letters, dates, lists, random codes or expressions at multiple cursors, with a live preview before anything is inserted.",
  "version": "1.0.1",
  "publisher": "ducnvx",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngovanxuanduc/insert-numbers-live.git"
  },
  "bugs": {
    "url": "https://github.com/ngovanxuanduc/insert-numbers-live/issues"
  },
  "homepage": "https://github.com/ngovanxuanduc/insert-numbers-live#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "insert numbers",
    "multi-cursor",
    "multiple cursors",
    "sequence",
    "increment",
    "enumerate",
    "numbering",
    "random",
    "uuid",
    "template"
  ],
  "galleryBanner": {
    "color": "#3B4FD8",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "insertNumbersLive.insert",
        "title": "Insert Sequence at Cursors",
        "category": "Insert Numbers Live"
      },
      {
        "command": "insertNumbersLive.clearHistory",
        "title": "Clear History",
        "category": "Insert Numbers Live"
      }
    ],
    "keybindings": [
      {
        "command": "insertNumbersLive.insert",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Insert Numbers Live",
      "properties": {
        "insertNumbersLive.order": {
          "type": "string",
          "enum": [
            "position",
            "selection"
          ],
          "enumDescriptions": [
            "Number cursors top to bottom by their position in the document.",
            "Number cursors in the order they were created (click order)."
          ],
          "default": "position",
          "description": "Order in which cursors are numbered."
        },
        "insertNumbersLive.replaceSelection": {
          "type": "boolean",
          "default": true,
          "description": "When a cursor has text selected: replace it (true) or insert after it (false)."
        },
        "insertNumbersLive.historySize": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Number of recent inputs remembered for reuse."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.94.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
